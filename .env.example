# ---------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------
HOST=localhost
PORT=3000

# ---------------------------------------------------------------
# PostgreSQL (dibaca otomatis oleh pg dan node-pg-migrate)
# ---------------------------------------------------------------
PGUSER=
PGPASSWORD=
PGDATABASE=openjob_v2_db
PGHOST=localhost
PGPORT=5432

# ---------------------------------------------------------------
# JWT: isi dengan string acak yang panjang (jangan dibagikan)
# ---------------------------------------------------------------
ACCESS_TOKEN_KEY=
REFRESH_TOKEN_KEY=
ACCESS_TOKEN_AGE=3h
REFRESH_TOKEN_AGE=7d

# ---------------------------------------------------------------
# Redis (cache)
# ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Kosongkan bila Redis lokal tanpa password
REDIS_PASSWORD=

# ---------------------------------------------------------------
# RabbitMQ (message queue). Juga dipakai docker-compose.yml.
# ---------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# ---------------------------------------------------------------
# Email (Nodemailer). Untuk uji lokal gunakan Ethereal atau Mailtrap.
# ---------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Alamat pengirim yang tampil di email notifikasi
MAIL_SENDER=OpenJob <no-reply@openjob.local>
