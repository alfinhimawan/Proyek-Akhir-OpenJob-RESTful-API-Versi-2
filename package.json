{
  "name": "openjob-restful-api-v2",
  "version": "2.0.0",
  "description": "OpenJob RESTful API Versi 2 - Proyek Akhir Belajar Fundamental Back-End dengan JavaScript (unggah PDF, Redis, RabbitMQ)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "nodemon src/server.js",
    "start:consumer": "node src/consumer/index.js",
    "start:consumer:dev": "nodemon src/consumer/index.js",
    "migrate": "node-pg-migrate -r dotenv/config",
    "migrate:up": "node-pg-migrate -r dotenv/config up",
    "migrate:down": "node-pg-migrate -r dotenv/config down",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "license": "ISC",
  "dependencies": {
    "amqplib": "^2.2.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10"
  }
}
